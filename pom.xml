<?xml version="1.0" encoding="UTF-8"?>
<!-- POM = Project Object Model: Maven reads this file to know how to build and run TALA. -->
<!-- Root element; the namespace/schema attributes below let tools validate the file. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- The POM format version; Maven 4.0.0 is the standard value. -->
    <modelVersion>4.0.0</modelVersion>
    <!-- Project identity: groupId = organization/package prefix, artifactId = project name, version = release number. -->
    <groupId>com.tala</groupId>
    <artifactId>tala-accounting</artifactId>
    <version>1.0.0</version>
    <!-- Settings reused by the build. -->
    <properties>
        <!-- Compile for Java 17 (needed for features like text blocks used in the code). -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Read source files as UTF-8 so symbols such as the peso sign display correctly. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <!-- Libraries the app needs; Maven downloads them automatically. -->
    <dependencies>
        <!-- MySQL JDBC driver: lets the Java code connect to the MySQL database that stores accounts and journal entries. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.5.0</version>
        </dependency>
    </dependencies>
    <!-- Build settings: which plugins run during compile and run. -->
    <build>
        <plugins>
            <!-- Compiler plugin: turns the .java files into .class files (uses the Java 17 setting above). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <!-- Exec plugin: lets us start the program with "mvn exec:java" (used by Run-TALA.bat). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <!-- The class with the main() method that starts the application. -->
                    <mainClass>com.tala.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
