<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build file (optional).
  Open the project folder in NetBeans / IntelliJ as a Maven project and it
  downloads MySQL Connector/J for you. Main class: tala.Main
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>tala</groupId>
    <artifactId>tala-accounting-system</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <name>TALA Accounting System</name>

    <properties>
        <maven.compiler.release>11</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <exec.mainClass>tala.Main</exec.mainClass>
    </properties>

    <dependencies>
        <!-- The MySQL JDBC driver (lets Java talk to MySQL) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- "mvn exec:java" runs the app -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>tala.Main</mainClass>
                </configuration>
            </plugin>
            <!-- puts "Main-Class: tala.Main" inside the jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>tala.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
